# Copy this file to .env and fill in the real values for local development.
# These variables are read with os.getenv(...) after load_dotenv() is called.

# DOMAIN and BASE_URL:
#   These are common backend settings for building links, callbacks, or email URLs.
#   In this tutorial they are kept as standard examples, but they are not used directly yet.
DOMAIN=localhost:8000
BASE_URL=http://localhost:8000

# MongoDB
# MONGODB_URL:
#   Used in core/database/database.py as the single MongoDB connection string
#   for this tutorial project.
MONGODB_URL=mongodb://localhost:27017

# DATABASE_NAME:
#   Used in core/database/database.py to decide which MongoDB database to connect to.
DATABASE_NAME=WMS

# JWT
# JWT_SECRET_KEY:
#   Used in commons/auth.py to sign and verify JWT tokens.
JWT_SECRET_KEY=replace_with_a_strong_local_development_secret

# JWT_ALGORITHM:
#   Used in commons/auth.py as the JWT signing algorithm.
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES:
#   Used in commons/auth.py to decide access-token lifetime.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Gemini AI (server-side only; never add this to frontend environment files)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email
# These are used by the prototype registration email flow.
gmail_user=
gmail_app_password=
company_name=Whitfield Fulfillment
support_email=support@example.com
logo_url=


